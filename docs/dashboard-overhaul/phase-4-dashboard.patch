+++ b/static/css/dashboard.css
@@ -0,0 +1,110 @@
+.db { max-width: 1320px; margin: 0 auto; padding: .25rem 0 2rem; }
+.db .db-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .6rem 1.5rem; min-height: 112px; margin: 0 0 1.15rem; padding: .9rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--wash) url('../img/dashboard-waves.svg') right bottom / cover no-repeat; }
+.db .db-head h1 { margin: 0 0 .4rem; font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); font-weight: 800; font-stretch: 106%; letter-spacing: -.02em; line-height: 1.15; }
+.db .db-title-group p { margin: 0; color: var(--ink-2); font-size: .8125rem; }
+.db .db-period { min-width: 280px; }
+.db .db-period-name { display: flex; align-items: center; gap: .9rem; justify-content: space-between; font-size: .8125rem; }
+.db .db-status { display: inline-flex; align-items: center; gap: .4rem; color: var(--ink-2); font-size: .6875rem; }
+.db .db-status .ui-lamp { width: 8px; height: 8px; }
+.db .db-period-dates, .db .db-period-timing { display: block; color: var(--ink-2); font-size: .6875rem; }
+.db .db-period-dates { margin-top: .2rem; }
+.db .db-term-rail { position: relative; height: 2px; margin: .55rem 4px .4rem; background: #B7C5C9; }
+.db .db-term-rail::before, .db .db-term-rail::after { content: ''; position: absolute; top: -2px; width: 6px; height: 6px; background: var(--paper); border: 1px solid var(--rail); border-radius: 50%; }
+.db .db-term-rail::before { left: -3px; }
+.db .db-term-rail::after { right: -3px; }
+.db .db-term-rail span { position: absolute; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--rail); transform: translateX(-50%); z-index: 1; }
+.db .db-context { grid-column: 1 / -1; width: fit-content; margin: 0; color: var(--ink-2); background: #F5F6F3F2; border-radius: 3px; font-size: .75rem; line-height: 1.4; }
+.db .db-context a { font-weight: 650; }
+.db .db-banner { margin-bottom: 1rem; }
+.db .db-banner--setup { background: #FBF3E2; border-color: #DBC99E; border-left-color: var(--amber); }
+.db .db-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; margin-bottom: 1.5rem; }
+.db .db-kpis--people { grid-template-columns: minmax(0, 320px); }
+.db .db-kpis--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.db .db-kpis--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.db .db-kpi { position: relative; padding: 1rem 1.1rem; min-height: 153px; }
+.db .db-kpi h2 { margin: 0 0 .4rem; color: var(--ink-2); font-size: .8125rem; font-weight: 650; }
+.db .db-kpi h2 a { display: flex; justify-content: space-between; gap: .5rem; color: inherit; text-decoration: none; }
+.db .db-kpi h2 a:hover { color: var(--rail); }
+.db .db-kpi h2 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
+.db .db-kpi:has(a:hover) { border-color: #A8BAC9; background: #FCFDFC; }
+.db .db-kpi-value { font-size: clamp(1.8rem, 2.7vw, 2.5rem); letter-spacing: -.035em; line-height: 1.2; margin-bottom: .6rem; }
+.db .db-kpi p { margin: 0; color: var(--ink-2); font-size: .6875rem; line-height: 1.5; }
+.db .db-positive { color: var(--green); }
+.db .db-negative { color: var(--red); }
+.db .db-kpi-empty { font-size: 1.35rem; font-weight: 650; color: var(--ink-2); margin: .75rem 0; }
+.db .db-rail { height: 4px; overflow: hidden; border-radius: 4px; background: #E5E9E5; }
+.db .db-rail > span { display: block; height: 100%; background: var(--green); border-radius: inherit; }
+.db .db-collection { display: flex; align-items: center; gap: .55rem; margin: -.15rem 0 .25rem; }
+.db .db-collection .db-rail { flex: 1; }
+.db .db-collection > span { color: var(--ink-2); font-size: .625rem; white-space: nowrap; }
+.db .db-columns { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(310px, 1fr); gap: 1.25rem; align-items: start; }
+.db .db-columns--single { grid-template-columns: minmax(0, 1fr); }
+.db .db-columns--single .db-right { max-width: 720px; }
+.db .db-right { display: grid; gap: 1.25rem; min-width: 0; }
+.db .db-card-head { padding: 1rem 1.15rem .8rem; margin: 0; }
+.db .db-card-head h2 { font-size: 1.125rem; }
+.db .db-card-head p { font-size: .6875rem; }
+/* Keep absolutely positioned screen-reader text inside the table scroll area. */
+.db .db-table-scroll { position: relative; overflow-x: auto; border-top: 1px solid var(--line); }
+.db .db-table-scroll .ui-table { min-width: 570px; }
+.db .ui-table th { padding: .6rem .55rem; font-size: .6875rem; }
+.db .ui-table td { padding: .8rem .55rem; font-size: .75rem; }
+.db .ui-table th:first-child, .db .ui-table td:first-child { padding-left: 1.15rem; }
+.db .ui-table th:last-child, .db .ui-table td:last-child { padding-right: 1.15rem; }
+.db .ui-table tr[data-student-url] { cursor: pointer; }
+.db .db-student { display: block; color: var(--ink); font-size: .8125rem; font-weight: 750; line-height: 1.35; text-transform: uppercase; text-decoration: none; }
+.db a.db-student:hover { color: var(--rail); text-decoration: underline; text-underline-offset: 3px; }
+.db .db-student-number { display: block; margin-top: .2rem; color: var(--ink-2); font-size: .6875rem; line-height: 1.3; }
+.db .db-trade { color: var(--ink-2); max-width: 140px; }
+.db .db-date { color: var(--ink-2); white-space: nowrap; }
+.db .db-small-action { padding: .4rem .55rem; min-width: 42px; min-height: 44px; font-size: .6875rem; }
+.db .db-card-foot { padding: .75rem 1.15rem; border-top: 1px solid var(--line); font-size: .75rem; }
+.db .db-card-foot a { display: flex; justify-content: space-between; align-items: center; font-weight: 650; text-decoration: none; min-height: 28px; }
+.db .db-card-foot a:hover { text-decoration: underline; text-underline-offset: 3px; }
+.db .db-balance-list { list-style: none; padding: 0; margin: 0; }
+.db .db-balance-list > li { padding: .85rem 1.15rem; border-top: 1px solid var(--line); }
+.db .db-balance-top { display: flex; justify-content: space-between; align-items: start; gap: .7rem; }
+.db .db-balance-top > .ui-fig { font-size: 1rem; }
+.db .db-balance-meta { color: var(--ink-2); font-size: .6875rem; margin: .25rem 0; }
+.db .db-balance-bottom { display: flex; gap: 1rem; align-items: center; justify-content: space-between; }
+.db .db-balance-bottom .db-rail { flex: 1; max-width: 160px; }
+.db .db-balance-bottom .db-rail > span { background: var(--red); }
+.db .db-row-actions { display: flex; gap: .35rem; }
+.db .db-next .ui-todo-item { grid-template-columns: auto minmax(0, 1fr); padding: .85rem 1.15rem; gap: .45rem .75rem; }
+.db .db-next .ui-todo-text strong { font-size: .8125rem; }
+.db .db-next .ui-todo-text > span { font-size: .75rem; }
+.db .db-next .ui-todo-item > .ui-btn { grid-column: 2; justify-self: start; margin-top: .2rem; font-size: .75rem; padding: .5rem .75rem; }
+.db .db-empty { padding: 1.25rem 1.15rem 1.5rem; font-size: .875rem; }
+.db .db-empty p { color: var(--ink-2); font-size: .8125rem; margin: .35rem 0 0; }
+.db .db-all-clear { display: flex; align-items: center; gap: .75rem; color: var(--green); }
+.db .modal-content { border-color: var(--line); border-radius: var(--radius); }
+.db .modal-title { font-size: 1.25rem; font-weight: 750; }
+.db .modal-body { font-size: .875rem; }
+.ui.db-notices { max-width: 1320px; margin: 0 auto 1rem; }
+.ui .db-notice { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; margin-top: .5rem; font-size: .875rem; }
+@media (max-width: 1199px) {
+    .db .db-columns { grid-template-columns: minmax(0, 1fr); }
+    .db .db-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    .db .db-kpis--people { grid-template-columns: minmax(0, 320px); }
+    .db .db-head { gap: .75rem 1rem; padding: .9rem 1rem; }
+    .db .db-period { min-width: 250px; }
+    .db .db-title-group p { max-width: 240px; }
+    .db .db-kpi-value { font-size: 2.2rem; }
+}
+@media (max-width: 767px) {
+    .db .db-head { grid-template-columns: minmax(0, 1fr); }
+    .db .db-period { min-width: 0; }
+    .db .db-title-group p { max-width: none; }
+    .db .db-kpis, .db .db-kpis--people { grid-template-columns: minmax(0, 1fr); }
+    .db .db-kpi { min-height: 132px; }
+    .db .db-card-head h2 { font-size: 1.125rem; }
+}
+@media print {
+    .db .db-head { background: #fff; }
+    .db .db-kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+    .db .db-columns { display: block; }
+    .db .db-right { margin-top: 1rem; }
+    .db .db-table-scroll { overflow: visible; }
+    .db .db-next, .db .db-banner, .db .db-row-actions, .db .db-small-action, .db .modal { display: none !important; }
+    .db .ui-card { break-inside: avoid; }
+}
