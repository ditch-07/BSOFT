+    .sidebar-collapsed .sidebar-link,
+    .sidebar-collapsed .sidebar-rail-toggle { justify-content: center; padding: 10px 0; gap: 0; }
+    .sidebar-collapsed .sidebar-rail-toggle .sidebar-icon { transform: rotate(180deg); }
+}
+@media (max-width: 768px) {
+    .sidebar-menu-toggle { display: inline-flex; }
+    .sidebar-footer { display: none; }
+    .ui.sidebar-fixed { height: 100vh; height: 100dvh; }
+}
+@media (prefers-reduced-motion: reduce) {
+    .sidebar-fixed, .sidebar-fixed *, .sidebar-tooltip, .offcanvas-backdrop { transition: none !important; animation: none !important; }
+}
+@media print {
+    .sidebar-fixed, .sidebar-sprite, .sidebar-menu-toggle, .sidebar-rail-toggle, .offcanvas-backdrop, .sidebar-tooltip { display: none !important; }
+    .main-content { margin: 0 !important; height: auto !important; overflow: visible !important; }
