+    def freeze(self, day):
+        TimeOverride.set_frozen_time(
+            timezone.make_aware(datetime.combine(day, datetime.min.time()).replace(hour=12))
+        )
+        cache.clear()
+
+    def make_user(self, name, *permissions, superuser=False, staff=False):
+        user = get_user_model().objects.create_user(
+            username=name, password="dashboard-test",
+            is_superuser=superuser, is_staff=staff or superuser,
+        )
+        for codename in permissions:
+            user.user_permissions.add(Permission.objects.get(
+                content_type__app_label="school", codename=codename
+            ))
+        return user
+
+    def make_student(self, number, status=Student.ACTIVE):
+        return Student.objects.create(
+            student_number=number, first_name="Ada", last_name=number,
+            program=self.program, intake_year=self.year, status=status,
+        )
+
+    def enroll(self, student, semester=None, year_level=1, status=Enrollment.ACTIVE):
+        return Enrollment.objects.create(
+            student=student, program=self.program, semester=semester or self.semester,
+            year_level=year_level, status=status,
+        )
+
+    def charge(self, enrollment, amount="100.00"):
+        structure, _ = FeeStructure.objects.get_or_create(
+            semester=enrollment.semester, program=self.program,
+            year_level=enrollment.year_level,
+        )
+        item, _ = FeeStructureItem.objects.get_or_create(
+            fee_structure=structure, name="Tuition", defaults={"amount": amount}
+        )
+        return StudentCharge.objects.create(
+            student=enrollment.student, enrollment=enrollment,
+            fee_item=item, amount=amount,
+        )
+
+    def pay(self, student, receipt, amount="25.00", semester=None, day=None,
+            method=Payment.CASH):
+        return Payment.objects.create(
+            student=student, semester=semester or self.semester,
+            receipt_number=receipt, amount=amount,
+            payment_date=day or self.today, method=method,
+        )
+
+    def past_semester(self, year=2026, number=2):
+        academic_year, _ = AcademicYear.objects.get_or_create(
+            name=str(year), defaults={
+                "start_date": date(year, 1, 1), "end_date": date(year, 12, 31),
+            },
+        )
+        return Semester.objects.create(
+            academic_year=academic_year, number=number,
+            start_date=date(year, 1 if number == 1 else 7, 12),
+            end_date=date(year, 6 if number == 1 else 12, 28),
+        )
+
+    def next_year(self):
+        return AcademicYear.objects.create(
+            name="2028", start_date=date(2028, 1, 1), end_date=date(2028, 12, 31)
+        )
+
+    def next_year_semester(self, year, number=1):
+        return Semester.objects.create(
+            academic_year=year, number=number,
+            start_date=date(2028, 1 if number == 1 else 7, 12),
+            end_date=date(2028, 6 if number == 1 else 12, 28),
+        )
+
+    def get_dashboard(self, user):
+        self.client.force_login(user)
+        response = self.client.get(reverse("dashboard"))
+        self.assertEqual(response.status_code, 200)
+        return response
+
+    def one(self, node, **selector):
+        matches = node.select(**selector)
+        self.assertEqual(len(matches), 1, f"Expected one node matching {selector}, got {len(matches)}")
+        return matches[0]
+
+    def document(self, response):
+        return HTMLDocument(response.content.decode()).root
+
+    def db(self, response):
+        node = self.one(self.document(response), class_name="db")
+        self.assertIn("ui", node.attrs.get("class", "").split())
+        return node
+
+    def sidebar(self, user, route="dashboard", args=(), semester=True):
+        request = RequestFactory().get(reverse(route, args=args))
+        request.user = user
+        request.resolver_match = resolve(request.path)
+        context = {} if semester else {"nav_semester": None}
+        html = render_to_string("base.html", context, request=request)
+        return self.one(HTMLDocument(html).root, tag="nav", **{"aria-label": "Main"})
