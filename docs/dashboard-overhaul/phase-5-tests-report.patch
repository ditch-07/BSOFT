+    def setUp(self):
+        cache.clear()
+        self.addCleanup(cache.clear)
+        self.freeze(self.today)
+        # The real availability probe writes to the configured backup drive.
+        probe = patch.object(BackupConfig, "is_backup_available", return_value=True)
