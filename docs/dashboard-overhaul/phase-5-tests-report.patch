+    def test_every_money_permission_combination_and_student_link_gate(self):
+        student = self.make_student("MATRIX")
+        self.charge(self.enroll(student), "1250.00")
+        self.pay(student, "MATRIX-PAY")
+        permissions = (
+            "can_view_financial_reports", "can_record_payments",
+            "can_view_outstanding_reports", "view_student",
+        )
+        for index, bits in enumerate(product((False, True), repeat=4)):
+            with self.subTest(permissions=dict(zip(permissions, bits))):
+                user = self.make_user(
+                    f"matrix-{index}", *(p for p, enabled in zip(permissions, bits) if enabled)
+                )
+                response = self.get_dashboard(user)
+                db = self.db(response)
+                reports, payments, outstanding, students = bits
+                financial = reports or payments
+                self.assertEqual(response.context["show_financials"], financial)
+                self.assertEqual(response.context["show_outstanding"], outstanding)
+                expected = {"students"}
+                if financial:
+                    expected.update(("billed", "collected"))
+                if outstanding:
+                    expected.add("owed")
+                self.assertEqual(
+                    {node.attrs["data-kpi"] for node in db.select(class_name="db-kpi")}, expected
+                )
+                self.assertEqual(bool(db.select(class_name="db-payments")), financial)
+                self.assertEqual(bool(db.select(class_name="db-balances")), outstanding)
+                for key in ("total_charged", "total_paid", "today_total", "today_count", "recent_payments"):
+                    self.assertEqual(key in response.context, financial, key)
+                for key in ("outstanding", "students_with_balance", "top_outstanding"):
+                    self.assertEqual(key in response.context, outstanding, key)
+                for route, allowed in (
+                    ("student_list", students),
+                    ("financial_records", reports),
+                    ("daily_collections_report", reports),
+                    ("outstanding_report", outstanding),
+                ):
+                    self.assertEqual(reverse(route) in db.hrefs, allowed, route)
+                if not financial and not outstanding:
+                    self.assertNotIn("$", db.text)
+                    self.assertNotIn(student.student_number, db.text)
