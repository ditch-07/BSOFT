+        csrf_client = Client(enforce_csrf_checks=True)
+        csrf_client.force_login(user)
+        response = csrf_client.get(reverse("dashboard"))
+        self.assertEqual(response.status_code, 200)
+        db = self.db(response)
+        trigger = self.one(db, tag="button", **{"data-bs-target": f"#progress-{source.pk}"})
+        self.assertEqual(trigger.attrs["data-bs-toggle"], "modal")
+        self.assertNotIn("onclick", trigger.attrs)
+        modal = self.one(db, id=f"progress-{source.pk}")
+        self.assertIn("Progress 1 student?", modal.text)
+        self.assertIn("2026", modal.text)
+        self.assertIn("2027", modal.text)
+        form = self.one(modal, tag="form")
+        url = reverse("bulk_progress_students", args=[source.pk])
+        self.assertEqual(form.attrs["method"].lower(), "post")
+        self.assertEqual(form.attrs["action"], url)
+        token = self.one(form, tag="input", name="csrfmiddlewaretoken")
+        self.assertTrue(token.attrs["value"])
+        self.assertFalse(Enrollment.objects.filter(student=student, semester=self.semester).exists())
+        self.assertEqual(csrf_client.get(url).status_code, 405)
