+class HTMLNode:
+    """Small DOM for assertions scoped to dashboard or sidebar, not navbar."""
+
+    def __init__(self, tag="", attrs=()):
+        self.tag = tag
+        self.attrs = dict(attrs)
+        self.children = []
+
+    @property
+    def text(self):
+        return " ".join(
+            " ".join(
+                child.text if isinstance(child, HTMLNode) else child
+                for child in self.children
+            ).split()
+        )
+
+    def select(self, tag=None, class_name=None, **attrs):
+        matches = []
+        if (
+            (tag is None or self.tag == tag)
+            and (class_name is None or class_name in self.attrs.get("class", "").split())
+            and all(self.attrs.get(key) == value for key, value in attrs.items())
+        ):
+            matches.append(self)
+        for child in self.children:
+            if isinstance(child, HTMLNode):
+                matches.extend(child.select(tag, class_name, **attrs))
+        return matches
+
+    @property
+    def hrefs(self):
+        return {node.attrs["href"] for node in self.select("a") if "href" in node.attrs}
+
+
+class HTMLDocument(HTMLParser):
+    VOID_TAGS = {
+        "area", "base", "br", "col", "embed", "hr", "img", "input", "link",
+        "meta", "param", "source", "track", "wbr",
+    }
+
+    def __init__(self, html):
+        super().__init__(convert_charrefs=True)
+        self.root = HTMLNode()
+        self.stack = [self.root]
+        self.feed(html)
+        self.close()
+
+    def handle_starttag(self, tag, attrs):
+        node = HTMLNode(tag, attrs)
+        self.stack[-1].children.append(node)
+        if tag not in self.VOID_TAGS:
+            self.stack.append(node)
+
+    def handle_startendtag(self, tag, attrs):
+        self.stack[-1].children.append(HTMLNode(tag, attrs))
+
+    def handle_endtag(self, tag):
+        for index in range(len(self.stack) - 1, 0, -1):
+            if self.stack[index].tag == tag:
+                del self.stack[index:]
+                break
+
+    def handle_data(self, data):
+        self.stack[-1].children.append(data)
+
